<script>
  import { mount } from '../tools/modal-preview/ui.js';
  import { mountGenerator } from '../tools/modal-preview/generator.js';

  const app = document.getElementById('modal-app');
  const designer = mount(app.querySelector('[data-tool="designer"]'));
  const tabs = [...app.querySelectorAll('[data-tool-tab]')];
  const panels = {
    designer: app.querySelector('[data-tool="designer"]'),
    generator: app.querySelector('[data-tool="generator"]'),
  };

  function showTool(name) {
    for (const tab of tabs) {
      const on = tab.dataset.toolTab === name;
      tab.setAttribute('aria-selected', String(on));
    }
    for (const [key, panel] of Object.entries(panels)) panel.hidden = key !== name;
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => showTool(tab.dataset.toolTab));
  }

  mountGenerator(panels.generator, {
    openInDesigner(payload) {
      designer.receiveHandoff(payload);
      showTool('designer');
    },
  });
</script>
