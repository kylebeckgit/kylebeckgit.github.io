---
import Base from '../layouts/Base.astro';
---
<Base title="Modal preview" path="/z3-describe-preview.html" description="Unlisted preview. Design a modal body by hand, or generate variations from a sentence." robots="noindex, nofollow">
  <p class="eyebrow"><a href="/tools/">Tools</a></p>
  <h1>Modal preview</h1>
  <p class="lede">Two tools. The designer edits a body by hand. The generator reads a sentence into a few variations.</p>

  <div id="modal-app">
    <div class="tool-switch" role="tablist" aria-label="Tools">
      <button type="button" class="tool-tab" role="tab" id="tab-designer" data-tool-tab="designer" aria-controls="tool-designer" aria-selected="true">Modal designer</button>
      <button type="button" class="tool-tab" role="tab" id="tab-generator" data-tool-tab="generator" aria-controls="tool-generator" aria-selected="false">Modal generator</button>
    </div>

    <section id="tool-designer" data-tool="designer" role="tabpanel" aria-labelledby="tab-designer">
    <section class="panel" aria-labelledby="modal-heading">
      <h2 id="modal-heading">Modal designer</h2>
      <p class="quiet">Starts from a plain body. Randomize rolls a new one in this tool only.</p>
      <div class="stage">
      <div class="stage-view">
        <div class="view-switch" role="group" aria-label="Designer view">
          <button type="button" class="btn" data-view-mode="partials" aria-pressed="true">Partials</button>
          <button type="button" class="btn" data-view-mode="object" aria-pressed="false">Object</button>
        </div>
        <canvas data-view="zebra" aria-label="Modal partials. Click a mode to highlight it."></canvas>
        <canvas data-object hidden aria-label="Sounding object. Each partial is a mode of this body."></canvas>
      </div>
      <div class="stage-play">
      <p class="quiet">Click a line, or a row under More, to highlight it. Hold a key for the bow.</p>
      <p class="status" data-play-error role="status"></p>
      <div class="keys" data-keys role="group" aria-label="Pitch"></div>
      <div class="play-tools">
        <button type="button" class="btn" data-stop>Stop</button>
        <label class="play-field">Exciter
          <select data-exciter>
            <option value="click">Click</option>
            <option value="mallet">Mallet</option>
            <option value="burst">Noise burst</option>
            <option value="bow">Bow</option>
            <option value="file">Audio file</option>
          </select>
        </label>
        <label class="knob">Velocity <span data-velocity-out>0.80</span>
          <input data-velocity type="range" min="0" max="1" step="0.01" value="0.8">
        </label>
        <label class="knob" data-hardness-field hidden>Hardness <span data-hardness-out>0.50</span>
          <input data-hardness type="range" min="0" max="1" step="0.01" value="0.5">
        </label>
        <label class="play-field" data-file-field hidden>Exciter file
          <input data-exciter-file type="file" accept=".wav,.mp3,.aiff,.aif,audio/*">
        </label>
      </div>
      </div>
      </div>

      <div class="knob-groups">
        <div class="knobs knobs-4">
          <div class="knob">
            <label for="knob-tune">Tune</label>
            <button type="button" class="lock" data-lock="tune" aria-pressed="true" aria-label="Lock tune">Lock</button>
            <span data-tune-out>0</span>
            <input id="knob-tune" data-tune type="range" min="-48" max="48" step="1" value="0">
          </div>
          <div class="knob">
            <label for="knob-detune">Detune</label>
            <button type="button" class="lock" data-lock="detune" aria-pressed="false" aria-label="Lock detune">Lock</button>
            <span data-detune-out>0</span>
            <input id="knob-detune" data-detune type="range" min="-100" max="100" step="1" value="0">
          </div>
          <div class="knob">
            <label for="knob-decay">Decay</label>
            <button type="button" class="lock" data-lock="decay" aria-pressed="false" aria-label="Lock decay">Lock</button>
            <span data-modal-decay-out>0</span>
            <input id="knob-decay" data-modal-decay type="range" min="-100" max="100" step="1" value="0">
          </div>
          <div class="knob">
            <label for="knob-decay-kf">Decay KF</label>
            <button type="button" class="lock" data-lock="decayKf" aria-pressed="false" aria-label="Lock decay KF">Lock</button>
            <span data-decay-kf-out>0</span>
            <input id="knob-decay-kf" data-decay-kf type="range" min="-100" max="100" step="1" value="0">
          </div>
        </div>
        <div class="knobs knobs-2">
          <div class="knob">
            <label for="knob-position">Position</label>
            <button type="button" class="lock" data-lock="position" aria-pressed="false" aria-label="Lock position">Lock</button>
            <span data-position-out>0.18</span>
            <input id="knob-position" data-position type="range" min="0.02" max="0.98" step="0.01" value="0.18">
          </div>
          <div class="knob">
            <label for="knob-density">Density</label>
            <button type="button" class="lock" data-lock="density" aria-pressed="false" aria-label="Lock density">Lock</button>
            <select id="knob-density" data-density>
              <option value="8">8</option>
              <option value="16" selected>16</option>
              <option value="32">32</option>
              <option value="64">64</option>
              <option value="128">128</option>
              <option value="256">256</option>
            </select>
          </div>
        </div>
        <div class="knobs knobs-3">
          <div class="knob">
            <label for="knob-absorb">Absorb</label>
            <button type="button" class="lock" data-lock="absorb" aria-pressed="false" aria-label="Lock absorb">Lock</button>
            <span data-absorb-out>0</span>
            <input id="knob-absorb" data-absorb type="range" min="-100" max="100" step="1" value="0">
          </div>
          <div class="knob">
            <label for="knob-disperse">Disperse</label>
            <button type="button" class="lock" data-lock="disperse" aria-pressed="false" aria-label="Lock disperse">Lock</button>
            <span data-disperse-out>0</span>
            <input id="knob-disperse" data-disperse type="range" min="-100" max="100" step="1" value="0">
          </div>
          <div class="knob">
            <label for="knob-normalize">Normalize</label>
            <button type="button" class="lock" data-lock="normalize" aria-pressed="false" aria-label="Lock normalize">Lock</button>
            <span data-normalize-out>0</span>
            <input id="knob-normalize" data-normalize type="range" min="-100" max="100" step="1" value="0">
          </div>
        </div>
      </div>
      <div class="roll">
        <label class="knob">Material
          <select data-roll-material>
            <option value="any">Any</option>
            <option value="metal">Metal</option>
            <option value="wood">Wood</option>
            <option value="glass">Glass</option>
            <option value="skin">Skin</option>
            <option value="bell">Bell</option>
            <option value="wild">Wild</option>
          </select>
        </label>
        <label class="knob">Amount <span data-roll-amount-out>1.00</span>
          <input data-roll-amount type="range" min="0" max="1" step="0.01" value="1">
        </label>
        <label class="knob" data-wildness-field>Wildness <span data-roll-wildness-out>0.30</span>
          <input data-roll-wildness type="range" min="0" max="1" step="0.01" value="0.3">
        </label>
        <div class="roll-actions">
          <button type="button" class="btn solid" data-roll>Randomize</button>
          <button type="button" class="btn" data-roll-back disabled>Back</button>
          <button type="button" class="btn" data-roll-forward disabled>Forward</button>
        </div>
        <p class="roll-line" data-roll-read></p>
      </div>
      <p class="quiet">Tune starts locked.</p>

      <div class="save">
        <label>Name
          <input data-name type="text" value="Modal profile">
        </label>
        <button type="button" class="btn solid" data-export>Export profile</button>
        <p class="quiet export-hint" data-export-hint>In Zebra, set Decay to 50, Position 0, other modal knobs at 0.</p>
      </div>
    </section>

    <details class="more">
      <summary>More</summary>

      <div class="more-block">
        <h3>View</h3>
        <p class="quiet">Level is the crest and decay is the depth. Draw edits the graphic. Undo and redo follow those edits.</p>
        <div class="play-tools">
          <label class="play-field">View
            <select data-draw-style>
              <option value="eco">Eco</option>
              <option value="fast" selected>Fast</option>
              <option value="glow">Glow</option>
            </select>
          </label>
          <button type="button" class="btn" data-draw aria-pressed="false">Draw</button>
          <button type="button" class="btn" data-undo disabled>Undo</button>
          <button type="button" class="btn" data-redo disabled>Redo</button>
        </div>
      </div>

      <div class="more-block">
        <h3>File</h3>
        <div class="play-tools">
          <button type="button" class="btn" data-share>Copy link</button>
          <label class="btn">Import profile<input data-import type="file" accept=".csv,text/csv" hidden></label>
        </div>
        <p class="status" data-share-status role="status"></p>
      </div>

      <div class="more-block">
        <h3>Model</h3>
        <form class="model" onsubmit="return false">
          <label class="play-field wide">Starting point
            <select data-presets></select>
          </label>
          <div class="knobs knobs-4">
            <label class="knob">Stiffness <span data-stiffness-out>0.00</span>
              <input data-stiffness type="range" min="0" max="1" step="0.01" value="0">
            </label>
            <label class="knob">Brightness <span data-brightness-out>0.00</span>
              <input data-brightness type="range" min="-1" max="1" step="0.01" value="0">
            </label>
            <label class="knob">Damping <span data-damping-out>0.35</span>
              <input data-damping type="range" min="0" max="1" step="0.01" value="0.35">
            </label>
            <label class="knob">Odd and even <span data-odd-even-out>0.00</span>
              <input data-odd-even type="range" min="-1" max="1" step="0.01" value="0">
            </label>
          </div>
          <label class="seed">Seed
            <span class="seed-row"><input data-seed type="number" min="0" step="1" value="0"><button type="button" class="btn" data-random>Randomize</button></span>
          </label>
          <p class="quiet">Moving these rebuilds the partials. Edits in the list stay until the next rebuild.</p>
        </form>
      </div>

      <div class="more-block">
        <h3>Partial list</h3>
        <p class="quiet">Click a number to make that partial ratio 1.</p>
        <div class="partial-scroll">
          <table class="partials">
            <thead><tr><th scope="col">#</th><th scope="col">Ratio</th><th scope="col">Level dB</th><th scope="col">Decay</th></tr></thead>
            <tbody data-partials></tbody>
          </table>
        </div>
      </div>

      <div class="more-block">
        <h3>From a recording</h3>
        <p class="quiet">Drop a wav, mp3, or aiff. Partials are measured in this browser. The file is not uploaded.</p>
        <div class="drop" data-drop>
          <label class="btn">Choose a recording<input data-recording type="file" accept=".wav,.mp3,.aiff,.aif,audio/*" hidden></label>
        </div>
        <div class="analyze-grid">
          <label>Root
            <input data-fundamental type="text" placeholder="Auto, or A3, or 220">
          </label>
          <label class="knob">Threshold <span data-threshold-out>40</span>
            <input data-threshold type="range" min="12" max="80" step="1" value="40">
          </label>
          <label>Max partials
            <input data-max-partials type="number" min="1" max="64" step="1" value="64">
          </label>
        </div>
        <div class="play-tools">
          <button type="button" class="btn" data-analyze>Analyze</button>
          <button type="button" class="btn" data-root-down disabled>Octave down</button>
          <button type="button" class="btn" data-root-up disabled>Octave up</button>
        </div>
        <p class="quiet" data-root-readout>Root appears after analysis.</p>
        <p class="quiet">Type a note or a frequency to override the root. Noisy takes can be thinned with the threshold.</p>
        <p class="status" data-analyze-msg role="status"></p>
      </div>
    </details>
    </section>

    <section id="tool-generator" data-tool="generator" role="tabpanel" aria-labelledby="tab-generator" hidden>
      <h2 class="tool-title">Modal generator</h2>
      <p class="quiet">The sentence is read in this browser. Nothing is sent. Command or Ctrl+Enter describes. Randomize here does not change the designer.</p>
      <section class="describe" aria-labelledby="describe-heading">
        <h3 id="describe-heading" class="visually-hidden">Describe</h3>
        <div class="ask-bar">
          <label class="ask">Describe
            <textarea data-ask rows="3" placeholder="Glass bowl struck softly, slightly detuned, long shimmer"></textarea>
          </label>
          <button type="button" class="btn solid" data-ask-btn>Describe</button>
        </div>
        <p class="quiet" data-allowance></p>
        <p class="status" data-studio-status role="status"></p>
        <div data-results hidden>
          <h3>Variations</h3>
          <ol class="thread" data-thread></ol>
          <div class="var-grid" data-cards></div>
          <div class="refine">
            <label>Refine
              <input data-refine-text type="text" placeholder="Darker, or a shorter tail" enterkeyhint="send">
            </label>
            <button type="button" class="btn" data-refine-btn>Refine</button>
            <button type="button" class="btn" data-step-back disabled>Step back</button>
          </div>
        </div>
      </section>
      <div class="gen-preview">
        <div class="stage-view">
          <div class="view-switch" role="group" aria-label="Generator view">
            <button type="button" class="btn" data-view-mode="partials" aria-pressed="true">Partials</button>
            <button type="button" class="btn" data-view-mode="object" aria-pressed="false">Object</button>
          </div>
          <canvas data-gen-view aria-label="Generator preview"></canvas>
          <canvas data-gen-object hidden aria-label="Sounding object. Each partial is a mode of this body."></canvas>
        </div>
        <div class="gen-actions">
          <button type="button" class="btn" data-gen-hear>Hear</button>
          <button type="button" class="btn solid" data-open-designer disabled>Open in designer</button>
          <p class="status" data-gen-audio role="status"></p>
        </div>
      </div>
      <div class="roll gen-roll">
        <label class="knob">Wildness <span data-gen-wild-out>0.30</span>
          <input data-gen-wild type="range" min="0" max="1" step="0.01" value="0.3">
        </label>
        <div class="roll-actions">
          <button type="button" class="btn solid" data-gen-roll>Randomize</button>
          <button type="button" class="btn" data-gen-back disabled>Back</button>
          <button type="button" class="btn" data-gen-forward disabled>Forward</button>
        </div>
        <p class="quiet">A low wildness rolls familiar bodies. Higher wildness mixes unusual ones that still play.</p>
      </div>
      <div class="more-block">
        <h3>Starters</h3>
        <p class="quiet">Fixed recipes, when you want a known object before writing your own.</p>
        <div class="starter-row" data-starters></div>
      </div>
    </section>
  </div>
</Base>

<style>
  #modal-app { margin-top: 1.75rem; }
  .tool-switch {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.35rem;
    border-bottom: 1px solid var(--line);
  }
  .tool-tab {
    font: inherit;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--muted);
    background: transparent;
    border: 0;
    border-bottom: 3px solid transparent;
    padding: .75rem .1rem .65rem;
    margin-bottom: -1px;
    cursor: pointer;
  }
  .tool-tab[aria-selected="true"] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }
  .tool-title { margin: 1.25rem 0 .35rem; }
  .gen-preview {
    display: grid;
    gap: 1rem;
    align-items: end;
    margin-top: 1.25rem;
  }
  @media (min-width: 800px) {
    .gen-preview { grid-template-columns: minmax(0, 22rem) auto; }
  }
  canvas[data-gen-view], canvas[data-gen-object] { width: min(100%, 22rem); }
  .stage-view { min-width: 0; }
  .view-switch { display: flex; gap: .4rem; margin-bottom: .45rem; }
  .view-switch .btn[aria-pressed="true"] { background: var(--fg); color: var(--bg); }
  canvas[hidden] { display: none; }
  canvas[data-object], canvas[data-gen-object] { touch-action: pan-y; cursor: default; }
  .gen-actions { display: flex; flex-wrap: wrap; gap: .6rem; }
  .gen-actions .btn { min-height: 2.75rem; }
  .gen-roll { margin-top: 1.25rem; }
  .gen-roll > .quiet { grid-column: 1 / -1; margin-top: 0; }
  #modal-app :global(button),
  #modal-app :global(select),
  #modal-app :global(input),
  #modal-app :global(textarea) {
    font-family: var(--body);
    font-stretch: var(--body-stretch);
    font-weight: 500;
    font-size: .95rem;
  }
  #modal-app :global(button.btn) { font-weight: 550; }
  .quiet { color: var(--muted); max-width: 62ch; margin: .65rem 0 0; font-size: .95rem; }
  .status { color: var(--fg); min-height: 0; margin: .5rem 0 0; }
  .status:empty { display: none; }
  .describe { max-width: 52rem; }
  .ask-bar {
    display: grid;
    gap: .75rem;
    align-items: end;
    margin-top: .85rem;
  }
  @media (min-width: 720px) {
    .ask-bar { grid-template-columns: minmax(0, 1fr) auto; }
  }
  .ask, .refine label, .play-field, .analyze-grid label, .save label, .seed {
    display: flex;
    flex-direction: column;
    gap: .35rem;
  }
  textarea, select, .refine input, .save input, .seed-row input, .analyze-grid input, .play-field input[type="file"] {
    font: inherit;
    color: inherit;
    padding: .55rem .65rem;
    border: 1px solid var(--line);
    background: var(--bg);
    border-radius: 4px;
  }
  textarea { width: 100%; min-height: 6.5rem; resize: vertical; }
  .ask-bar .btn { min-height: 2.75rem; }
  .thread { margin: .35rem 0 1rem; padding-left: 1.2rem; color: var(--muted); }
  .thread li { margin: .15rem 0; }
  .var-grid { display: grid; gap: .75rem; }
  @media (min-width: 860px) { .var-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  :global(.var-card) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: .9rem;
    display: flex;
    flex-direction: column;
    gap: .45rem;
    min-height: 100%;
  }
  :global(.var-card.is-selected) { border-color: var(--fg); box-shadow: inset 3px 0 0 var(--accent); }
  :global(.var-card h3) { font-size: 1.15rem; }
  :global(.var-card p) { margin: 0; color: var(--muted); font-size: .95rem; }
  :global(.var-card .btn) { margin-top: auto; align-self: flex-start; min-height: 2.75rem; }
  .refine {
    display: grid;
    gap: .6rem;
    margin-top: 1rem;
    align-items: end;
  }
  @media (min-width: 760px) {
    .refine { grid-template-columns: minmax(0, 28rem) auto auto; }
  }
  .refine .btn { min-height: 2.75rem; }
  .panel {
    margin-top: 2.25rem;
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: 4px;
    padding: 1.1rem 1.1rem 1.25rem;
  }
  .panel h2 { margin-bottom: .75rem; }
  .stage { display: grid; gap: .25rem 1.5rem; align-items: end; }
  @media (min-width: 980px) {
    .stage { grid-template-columns: minmax(0, 34rem) minmax(16rem, 1fr); }
  }
  .stage-play .quiet { margin-top: 0; }
  .stage-play .play-tools { margin-top: .65rem; }
  canvas {
    width: min(100%, 640px);
    height: auto;
    aspect-ratio: 1.24;
    display: block;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    touch-action: none;
    cursor: default;
  }
  canvas.is-drawing { cursor: crosshair; }
  .keys { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .9rem; }
  :global(.key) { min-width: 2.75rem; min-height: 2.75rem; padding: .4rem .55rem; }
  :global(.key[aria-pressed="true"]) { background: var(--fg); color: var(--bg); }
  .play-tools {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1rem;
    align-items: end;
    margin-top: .85rem;
  }
  .play-field { flex: 1 1 11rem; max-width: 16rem; min-width: 9rem; }
  .play-field.wide { max-width: 22rem; }
  .play-field[hidden], .knob[hidden] { display: none; }
  .play-tools > .knob { flex: 1 1 11rem; max-width: 16rem; }
  .play-tools .btn { min-height: 2.75rem; }
  select, .play-field input[type="file"] { min-height: 2.75rem; }
  .knob-groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .knobs { display: grid; gap: .85rem 1.15rem; }
  .knobs-4, .knobs-2, .knobs-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 860px) {
    .knobs-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .knobs-2 { grid-template-columns: repeat(2, minmax(0, 14rem)); }
    .knobs-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .analyze-grid label.knob { display: grid; }
  .knob {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    column-gap: .45rem;
    row-gap: .15rem;
    align-items: baseline;
    font-size: .95rem;
  }
  .knob > span { color: var(--muted); font-variant-numeric: tabular-nums; justify-self: end; }
  .knob .lock {
    justify-self: end;
    font: inherit;
    font-size: .72rem;
    line-height: 1;
    padding: .2rem .4rem;
    min-height: 1.5rem;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    border-radius: 4px;
  }
  .knob .lock[aria-pressed="true"] {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
  .roll {
    display: grid;
    gap: .85rem 1.15rem;
    margin-top: 1rem;
    align-items: end;
  }
  @media (min-width: 860px) {
    .roll { grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) minmax(0, 1fr) auto; }
  }
  .roll-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .roll-actions .btn { min-height: 2.75rem; }
  .roll-line {
    grid-column: 1 / -1;
    margin: 0;
    min-height: 1.5rem;
    font-size: 1.05rem;
    color: var(--fg);
  }
  .roll-line:empty { display: none; }
  .roll .knob[hidden] { display: none; }
