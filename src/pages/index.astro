---
import Base from '../layouts/Base.astro';
import PackList from '../components/PackList.astro';
import packs from '../data/packs.json';
import activity from '../data/activity.json';
const fmt = (d) => new Date(d + 'T12:00:00').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
---
<Base path="/">
  <h1>Kyle Beck makes sounds, and the tools for making them.</h1>
  <p class="intro">Wavetables and multisample instruments for the Elektron Tonverk, setup guides for odd bits of gear, and small generators for u-he synths that run in your browser. <span class="todo">[BIO: a sentence about you, to confirm]</span></p>

  <section class="sec"><h2>Packs</h2><div><PackList packs={packs} /><p><a href="/packs/">All packs</a></p></div></section>

  <section class="sec"><h2>Library</h2><div><ul class="entries">
    <li><a class="t" href="/plus3-doremidi-guide/">Endorphin.es Plus 3 with the DOREMIDI MPC-10</a>, <span class="k">a setup guide</span><span class="d">How to get the Plus 3 expression pedal talking to software synthesizers through the MPC-10.</span></li>
    <li><a class="t" href="/library/tonverk-presets/">Tonverk presets</a>, <span class="k">single instruments</span><span class="d">Bass, keys, mallets and percussion multisamples, each pay what you want.</span></li>
  </ul></div></section>

  <section class="sec"><h2>Tools</h2><div><ul class="entries">
    <li><a class="t" href="/z3-webgpu.html">Modal Generator</a>, <span class="k">for Zebra 3</span><span class="d">Describe a modal profile in words and get one back. It runs on your own graphics card; nothing leaves the browser.</span></li>
    <li><a class="t" href="/uhm-generator.html">.uhm Generator</a>, <span class="k">for Hive 2</span><span class="d">Writes .uhm scripts with a small local model. No server, no API key.</span></li>
  </ul></div></section>

  <section class="sec"><h2>Lately</h2><div><ul class="entries">{activity.slice(0,4).map((a) => <li><a href={a.url}>{a.title.replace('Tonverk Multisample: ','')}</a> <span class="k">{a.type.toLowerCase()}, {fmt(a.date)}</span></li>)}</ul></div></section>
</Base>
