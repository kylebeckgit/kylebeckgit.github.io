---
import Base from '../layouts/Base.astro';
import copy from '../data/copy.json';
import { visible } from '../lib/copy.js';
const lede = visible(copy.about.lede);
const bio = visible(copy.about.bio);
const music = visible(copy.about.music);
const development = visible(copy.about.development);
---
<Base title="About" path="/about/">
  <p class="eyebrow">About</p>
  <h1>Kyle Beck</h1>
  {lede && <p class="lede">{lede}</p>}
  {bio && <p>{bio}</p>}
  {music && <h2 style="margin-top:2rem">Music</h2>}
  {music && <p>{music}</p>}
  {development && <h2 style="margin-top:2rem">Development</h2>}
  {development && <p>{development}</p>}
</Base>
