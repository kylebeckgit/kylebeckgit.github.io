---
import Base from '../layouts/Base.astro';
import copy from '../data/copy.json';
import { visible } from '../lib/copy.js';
const lede = visible(copy.about.lede);
const bio = visible(copy.about.bio);
const music = visible(copy.about.music);
---
<Base title="About" path="/about/">
  <p class="eyebrow">About</p>
  {lede ? <h1>{lede}</h1> : <h1>About</h1>}
  {bio && <p>{bio}</p>}
  {music && <h2 style="margin-top:2rem">Music</h2>}
  {music && <p>{music}</p>}
</Base>
