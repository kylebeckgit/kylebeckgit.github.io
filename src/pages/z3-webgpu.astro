---
import Base from '../layouts/Base.astro';
// Set PUBLIC_MODAL_DESCRIBE_URL at build time to the deployed Worker. Empty hides Describe.
const describeUrl = import.meta.env.PUBLIC_MODAL_DESCRIBE_URL || '';
---
<Base title="Modal generator" path="/z3-webgpu.html" description="Shape a Zebra 3 modal profile, hear a preview, and download the file.">
  <p class="eyebrow"><a href="/tools/">Tools</a></p>
  <h1>Modal generator</h1>
  <p class="lede">Shape the partials of a Zebra 3 modal profile, hear a preview, and download the file Zebra reads.</p>

  <div id="modal-app" data-describe-url={describeUrl}>
    <div class="modal-layout">
      <form class="modal-controls" onsubmit="return false">
        <label>Starting point
          <select data-presets></select>
        </label>
        <label>Stiffness <span data-stiffness-out>0.00</span>
          <input data-stiffness type="range" min="0" max="1" step="0.01" value="0">
        </label>
        <label>Brightness <span data-brightness-out>0.00</span>
          <input data-brightness type="range" min="-1" max="1" step="0.01" value="0">
        </label>
        <label>Damping <span data-damping-out>0.35</span>
          <input data-damping type="range" min="0" max="1" step="0.01" value="0.35">
        </label>
        <label>Odd and even <span data-odd-even-out>0.00</span>
          <input data-odd-even type="range" min="-1" max="1" step="0.01" value="0">
        </label>
        <label>Seed
          <span class="seed-row"><input data-seed type="number" min="0" step="1" value="0"><button type="button" class="btn" data-random>Randomize</button></span>
        </label>
        <p class="note">Moving these controls rebuilds all 64 partials. Edits in the list stay until the next rebuild.</p>
      </form>
      <div class="modal-stage">
        <canvas aria-label="Partial spectrum"></canvas>
        <div class="row">
          <button type="button" class="btn solid" data-stop>Stop</button>
          <button type="button" class="btn" data-export>Export profile</button>
          <label class="btn">Import profile<input data-import type="file" accept=".csv,text/csv" hidden></label>
        </div>
        <div class="keys" data-keys role="group" aria-label="Pitch"></div>
      </div>
    </div>

    <div class="partial-scroll">
      <table class="partials">
        <thead><tr><th scope="col">#</th><th scope="col">Ratio</th><th scope="col">Gain dB</th><th scope="col">Decay</th></tr></thead>
        <tbody data-partials></tbody>
      </table>
    </div>

    <section data-describe hidden>
      <h2>Describe</h2>
      <p class="note">Optional. Sends one sentence to a small model, which sets the controls above. The editor works without it.</p>
      <textarea data-describe-text rows="3" placeholder="A short bright bar"></textarea>
      <div class="row"><button type="button" class="btn" data-describe-btn>Describe</button></div>
      <p class="note" data-describe-msg></p>
    </section>
  </div>
</Base>

<style>
  #modal-app { margin-top: 2rem; }
  .modal-layout { display: grid; gap: 2rem; }
  @media (min-width: 860px) { .modal-layout { grid-template-columns: 18rem minmax(0, 1fr); align-items: start; } }
  .modal-controls { display: flex; flex-direction: column; gap: 1rem; }
  .modal-controls label, .partials input, select, textarea {
    font: inherit;
    color: inherit;
  }
  .modal-controls label { display: flex; flex-direction: column; gap: .35rem; }
  .modal-controls span { color: var(--muted); }
  .modal-controls input[type="range"] { width: 100%; accent-color: var(--accent); }
  .seed-row { display: flex; gap: .5rem; align-items: center; }
  .seed-row input { width: 7rem; padding: .4rem .5rem; border: 1px solid var(--line); background: var(--card); border-radius: 4px; }
  select, textarea {
    padding: .5rem .6rem;
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: 4px;
  }
  textarea { width: 100%; max-width: 40rem; margin-top: .75rem; }
  canvas { width: 100%; height: 240px; display: block; background: var(--card); border: 1px solid var(--line); border-radius: 4px; }
  .keys { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }
  .key { padding: .45rem .6rem; }
  .key[aria-pressed="true"] { background: var(--fg); color: var(--bg); }
  .partial-scroll { margin-top: 1.5rem; max-height: 22rem; overflow: auto; border-top: 1px solid var(--fg); }
  table.partials { width: 100%; border-collapse: collapse; }
  table.partials th, table.partials td { text-align: left; padding: .45rem .6rem .45rem 0; border-bottom: 1px solid var(--line); }
  table.partials th { color: var(--muted); font-weight: 500; }
  table.partials input { width: 7rem; max-width: 100%; padding: .3rem .4rem; border: 1px solid var(--line); background: var(--card); border-radius: 4px; }
  [data-describe] { margin-top: 2.5rem; }
</style>

<script>
  import { mount } from '../tools/modal/ui.js';
  mount(document.getElementById('modal-app'));
</script>
