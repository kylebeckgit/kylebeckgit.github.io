---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import DemoList from '../../components/DemoList.astro';
import packs from '../../data/packs.json';
export function getStaticPaths(){ return packs.map((p) => ({ params:{ slug:p.slug }, props:{ p } })); }
const { p } = Astro.props;
// Free sampler toggle: packs.json demo.mode, or PUBLIC_DEMO_MODE=email-required|email-optional
const demoMode = import.meta.env.PUBLIC_DEMO_MODE || p.demo.mode;
const demoLs = demoMode === 'email-required';
const samplerHref = demoLs ? p.demo.lsCheckoutUrl : p.demo.directUrl;
const others = packs.filter((x) => x.slug !== p.slug);
---
<Base title={p.title} path={`/packs/${p.slug}/`} description={`${p.title}: ${p.subtitle} by Kyle Beck.`}>
  <p class="crumb"><a href="/packs/">Packs</a></p>
  <section class="hero" id="hero">
    <Cover p={p} />
    <div class="hero-body">
      <h1>{p.title}</h1>
      <p class="pitch">{p.subtitle}. {p.pitch}</p>
      <p class="price">{p.price}</p>
      <div class="buyrow">
        <a class="buy lemonsqueezy-button" href={p.buyUrl}>Buy</a>
        <a class={`sec-link ${demoLs ? 'lemonsqueezy-button' : ''}`} href={samplerHref}>Free sampler</a>
      </div>
      <p class="fine">Instant download. Works with {p.worksWith.device}, {p.worksWith.os}.</p>
      <nav class="jump" aria-label="On this page"><a href="#listen">Listen</a><a href="#inside">What's inside</a><a href="#works">Works with</a><a href="#made">How it was made</a><a href="#faq">FAQ</a></nav>
    </div>
  </section>

  <section class="block" id="listen"><h2>Listen</h2><DemoList demos={p.demos} /></section>

  <div class="two">
    <section class="block box" id="inside"><h2>What's inside</h2>
      <table class="spec"><tbody>{p.inside.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table>
    </section>
    <section class="block box dark" id="works"><h2>Works with</h2>
      <p><strong>{p.worksWith.device}</strong>, {p.worksWith.os}</p>
      <h3>How to load it</h3><ol>{p.worksWith.load.map((s) => <li>{s}</li>)}</ol>
    </section>
  </div>

  <section class="block made" id="made"><h2>How it was made</h2>
    <p class="story">{p.story}</p>
    <div class="photos">{p.photos.map((ph) => <div class="photo-ph" role="img" aria-label="Photo placeholder">{ph}</div>)}</div>
  </section>

  <section class="block sampler"><div>
    <h2>Free sampler</h2>
    <p>{p.demo.label}. {demoLs ? 'Enter your email at checkout and the download link arrives by email. It costs nothing.' : 'Direct download, no email needed.'}</p>
  </div><a class={`sec-link big ${demoLs ? 'lemonsqueezy-button' : ''}`} href={samplerHref}>Get the free sampler</a></section>

  <section class="block" id="faq"><h2>FAQ</h2>
    <dl class="faq">{p.faq.map(([q, a]) => <><dt>{q}</dt><dd>{a}</dd></>)}</dl>
    <h3>License</h3><p>{p.license}</p>
  </section>

  <section class="block"><h2>More from Kyle</h2>
    {others.length ? <ul class="packlist">{others.map((o) => <li><a href={`/packs/${o.slug}/`}>{o.title}</a></li>)}</ul>
      : <p>More packs are on the way. Meanwhile, the <a href="/#h-free">free Tonverk instruments</a> are on the home page.</p>}
  </section>

  <div class="stickybar" id="stickybar" aria-hidden="true">
    <div class="wrap"><span class="sb-title">{p.title}</span><span class="sb-price">{p.price}</span><a class="buy lemonsqueezy-button" href={p.buyUrl} tabindex="-1">Buy</a></div>
  </div>
  <script>
    const bar = document.getElementById('stickybar'), hero = document.getElementById('hero');
    new IntersectionObserver(([e]) => { const show = !e.isIntersecting; bar.classList.toggle('show', show); bar.setAttribute('aria-hidden', String(!show)); bar.querySelector('a').tabIndex = show ? 0 : -1; }).observe(hero);
  </script>
  <!-- Lemon Squeezy overlay checkout: .lemonsqueezy-button links open the overlay -->
  <script is:inline src="https://app.lemonsqueezy.com/js/lemon.js" defer></script>
</Base>
