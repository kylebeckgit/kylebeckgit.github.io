---
import Base from '../../layouts/Base.astro';
import packs from '../../data/packs.json';
export function getStaticPaths(){ return packs.map((p) => ({ params:{ slug:p.slug }, props:{ p } })); }
const { p } = Astro.props;
// Demo toggle: packs.json demo.mode, or override at build with PUBLIC_DEMO_MODE=email-required|email-optional
const demoMode = import.meta.env.PUBLIC_DEMO_MODE || p.demo.mode;
const demoLs = demoMode === 'email-required';
---
<Base title={`${p.title}: ${p.subtitle}`} path={`/packs/${p.slug}/`} description={`${p.title}, a ${p.subtitle.toLowerCase()} by Kyle Beck.`}>
  <p class="eyebrow"><a href="/packs/">Packs</a> / {p.platform}</p>
  <div class="product">
    <div class="ph cover" role="img" aria-label="Cover art placeholder">[COVER ART: pending]</div>
    <div>
      <h1>{p.title}</h1>
      <p class="lede">{p.subtitle}</p>
      <p>{p.blurb}</p>
      <div class="row">
        <a class="btn solid lemonsqueezy-button" href={p.buyUrl}>Buy · {p.price}</a>
        {demoLs
          ? <a class="btn lemonsqueezy-button" href={p.demo.lsCheckoutUrl}>{p.demo.label} (email for download link)</a>
          : <a class="btn" href={p.demo.directUrl} download>{p.demo.label}</a>}
      </div>
      <dl class="spec">
        <dt>Platform</dt><dd>{p.platform}</dd>
        <dt>Requires</dt><dd>{p.requirements}</dd>
        <dt>Status</dt><dd>{p.status}</dd>
      </dl>
      <h2>What's inside</h2>
      <ul>{p.contents.map((c) => <li>{c}</li>)}</ul>
      <h2>Listen</h2>
      {p.audio.map((a) => <figure style="margin:0 0 .75rem"><div class="ph">{a}</div><!-- <audio controls preload="none" src="/audio/..."></audio> --></figure>)}
      <h2>License</h2>
      <p class="ph">[LICENSE: royalty-free use in released music, no redistribution of raw samples. Wording to confirm]</p>
    </div>
  </div>
  <!-- Lemon Squeezy overlay checkout: turns .lemonsqueezy-button links into an overlay. Checkout URLs should end in ?embed=1 -->
  <script is:inline src="https://app.lemonsqueezy.com/js/lemon.js" defer></script>
</Base>
