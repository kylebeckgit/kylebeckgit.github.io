---
import Base from '../../layouts/Base.astro';
import packs from '../../data/packs.json';
export function getStaticPaths(){ return packs.map((p) => ({ params:{ slug:p.slug }, props:{ p } })); }
const { p } = Astro.props;
// Demo toggle: packs.json demo.mode, or override at build with PUBLIC_DEMO_MODE=email-required|email-optional
const demoMode = import.meta.env.PUBLIC_DEMO_MODE || p.demo.mode;
const demoLs = demoMode === 'email-required';
---
<Base title={p.title} path={`/packs/${p.slug}/`} description={`${p.title}: ${p.subtitle.toLowerCase()} by Kyle Beck.`}>
  <p><a href="/packs/">Packs</a></p>
  <div class="product">
    <div class="cover" role="img" aria-label="Cover art to come">cover art to come</div>
    <div>
      <h1>{p.title}</h1>
      <p class="intro">{p.subtitle}. <span class="todo">{p.blurb}</span></p>
      <p class="actions">
        <a class="buy lemonsqueezy-button" href={p.buyUrl}>Buy it, <span class="todo">{p.price}</span></a>
        {demoLs
          ? <a class="lemonsqueezy-button" href={p.demo.lsCheckoutUrl}>Get the free demo</a>
          : <a href={p.demo.directUrl} download>Download the free demo</a>}
      </p>
      <p class="k"><span class="todo">{p.demo.label}</span>{demoLs ? '. We email you the download link.' : '. No sign-up needed.'}</p>
    </div>
  </div>
  <section class="sec"><h2>In the pack</h2><div>
    <table class="contents"><tbody>
      <tr><th scope="row">Wavetables</th><td><span class="todo">[count, to confirm]</span></td></tr>
      <tr><th scope="row">Frames</th><td><span class="todo">[frames per table, to confirm]</span></td></tr>
      <tr><th scope="row">Format</th><td><span class="todo">[file format, sample rate, bit depth, to confirm]</span></td></tr>
      <tr><th scope="row">Works with</th><td>{p.platform}, <span class="todo">{p.requirements}</span></td></tr>
    </tbody></table>
  </div></section>
  <section class="sec"><h2>Listen</h2><div>{p.audio.map((a) => <p><span class="todo">{a}</span></p>)}</div></section>
  <section class="sec"><h2>Licence</h2><div><p><span class="todo">[LICENSE: wording to confirm]</span></p></div></section>
  <!-- Lemon Squeezy overlay checkout: turns .lemonsqueezy-button links into an overlay. Checkout URLs should end in ?embed=1 -->
  <script is:inline src="https://app.lemonsqueezy.com/js/lemon.js" defer></script>
</Base>
