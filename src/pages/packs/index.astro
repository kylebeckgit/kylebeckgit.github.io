---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import packs from '../../data/packs.json';
---
<Base title="Packs" path="/packs/" description="Wavetable and sample packs for the Elektron Tonverk by Kyle Beck.">
  <h1>Packs</h1>
  <p class="note">Sounds made for the Elektron Tonverk. Each pack has a free sampler.</p>
  <ul class="packlist">{packs.map((p) => (
    <li><a href={`/packs/${p.slug}/`} class="pl-cover"><Cover p={p} size="sm" /></a>
      <div><a class="pl-title" href={`/packs/${p.slug}/`}>{p.title}</a><p>{p.subtitle}</p></div><span class="pl-price">{p.price}</span></li>))}
  </ul>
  <p class="note">Free single instruments are on the <a href="/#h-free">home page</a>.</p>
</Base>
