---
import Base from '../../layouts/Base.astro';
import PackList from '../../components/PackList.astro';
import packs from '../../data/packs.json';
---
<Base title="Packs" path="/packs/" description="Wavetable and multisample packs for the Elektron Tonverk by Kyle Beck.">
  <h1>Packs</h1>
  <p class="intro">Sounds made for the Elektron Tonverk. Each pack has a free demo, so you can hear it on your own machine before paying.</p>
  <section class="sec"><h2>Available</h2><div><PackList packs={packs} /></div></section>
  <section class="sec"><h2>Singles</h2><div><p>Individual multisample instruments are in the <a href="/library/tonverk-presets/">Tonverk presets</a> list.</p></div></section>
</Base>
