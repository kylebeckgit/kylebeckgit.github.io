---
import Base from '../layouts/Base.astro';
import article from '../content/making-lovesac-stealthtech-smart.md?raw';

const DASH_W = 368;
const DASH_H = 800;

function escapeHtml(value) {
  return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function inline(value) {
  let text = escapeHtml(value);
  text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
  text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label, href) => {
    const rel = href.startsWith('http') ? ' rel="noopener"' : '';
    return `<a href="${href}"${rel}>${label}</a>`;
  });
  text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  return text;
}

function tableHtml(rows) {
  const parsed = rows.map((row) => row.split('|').slice(1, -1).map((cell) => cell.trim()));
  const kept = parsed.filter((cols) => !cols.every((cell) => /^:?-+:?$/.test(cell)));
  const [head, ...body] = kept;
  const headHtml = head.map((cell) => `<th>${inline(cell)}</th>`).join('');
  const bodyHtml = body.map((cols) => `<tr>${cols.map((cell) => `<td>${inline(cell)}</td>`).join('')}</tr>`).join('');
  return `<div class="table-scroll"><table><thead><tr>${headHtml}</tr></thead><tbody>${bodyHtml}</tbody></table></div>`;
}

const buyBox = `<aside class="kit"><p class="kit-title">What you'd buy</p><ul>
<li><a href="https://www.amazon.com/dp/B09HC5GRKY" rel="noopener">WiiM Mini</a></li>
<li><a href="https://shop.m5stack.com/products/atom-lite-esp32-development-kit" rel="noopener">M5Stack ATOM Lite</a></li>
<li><a href="https://www.amazon.com/dp/B00NH11H38" rel="noopener">The one that came with your StealthTech works fine. If you've misplaced it, an Amazon Basics 6 ft cable will do.</a></li>
<li>Home Assistant is free software; see the <a href="#words">glossary below</a>.</li>
</ul></aside>`;

const diagram = `<figure class="diagram">
<svg role="img" aria-label="The TV reaches the StealthTech by HDMI-ARC, the WiiM Mini by optical, and both phones AirPlay to a group with the HomePods. Home Assistant on the Mac Studio switches the input through an ATOM Lite Bluetooth proxy." viewBox="0 0 360 770" width="360" height="770">
  <defs>
    <marker id="lovesac-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0 0 L8 4 L0 8 Z" fill="var(--accent)"></path>
    </marker>
  </defs>
  <rect x="16" y="8" width="150" height="52" rx="8" fill="var(--card)" stroke="var(--line)"></rect>
  <text x="91" y="38" text-anchor="middle" font-family="Figtree, sans-serif" font-size="15" font-weight="650" fill="var(--fg)">My Phone</text>
  <rect x="194" y="8" width="150" height="52" rx="8" fill="var(--card)" stroke="var(--line)"></rect>
  <text x="269" y="38" text-anchor="middle" font-family="Figtree, sans-serif" font-size="15" font-weight="650" fill="var(--fg)">Wife's Phone</text>
  <line x1="91" y1="60" x2="91" y2="108" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#lovesac-arrow)"></line>
  <text x="98" y="86" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">AirPlay</text>
  <line x1="269" y1="60" x2="269" y2="108" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#lovesac-arrow)"></line>
  <text x="204" y="86" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">AirPlay</text>
  <path d="M16 40 H8 V500 H28" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#lovesac-arrow)"></path>
  <path d="M344 40 H352 V500 H332" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#lovesac-arrow)"></path>
  <rect x="28" y="112" width="304" height="268" rx="12" fill="color-mix(in srgb, var(--accent) 12%, var(--card))" stroke="var(--line)"></rect>
  <text x="180" y="136" text-anchor="middle" font-family="Figtree, sans-serif" font-size="13" font-weight="650" fill="var(--fg)">AirPlay 2 group</text>
  <text x="180" y="154" text-anchor="middle" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">Plays together</text>
  <rect x="78" y="168" width="204" height="44" rx="8" fill="var(--card)" stroke="var(--line)"></rect>
  <text x="180" y="195" text-anchor="middle" font-family="Figtree, sans-serif" font-size="15" font-weight="650" fill="var(--fg)">HomePods</text>
  <rect x="78" y="228" width="204" height="44" rx="8" fill="var(--card)" stroke="var(--line)"></rect>
  <text x="180" y="255" text-anchor="middle" font-family="Figtree, sans-serif" font-size="15" font-weight="650" fill="var(--fg)">WiiM Mini</text>
  <line x1="180" y1="272" x2="180" y2="300" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#lovesac-arrow)"></line>
  <text x="188" y="290" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">optical</text>
  <rect x="48" y="304" width="264" height="52" rx="8" fill="var(--card)" stroke="var(--line)"></rect>
  <text x="180" y="335" text-anchor="middle" font-family="Figtree, sans-serif" font-size="15" font-weight="650" fill="var(--fg)">Lovesac StealthTech</text>
  <rect x="78" y="404" width="204" height="44" rx="8" fill="var(--card)" stroke="var(--line)"></rect>
  <text x="180" y="431" text-anchor="middle" font-family="Figtree, sans-serif" font-size="15" font-weight="650" fill="var(--fg)">TV</text>
  <line x1="180" y1="404" x2="180" y2="380" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#lovesac-arrow)"></line>
  <text x="188" y="396" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">HDMI-ARC</text>
  <text x="180" y="478" text-anchor="middle" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">Couch dashboard over Wi-Fi</text>
  <rect x="28" y="508" width="304" height="118" rx="8" fill="var(--card)" stroke="var(--line)"></rect>
  <text x="180" y="532" text-anchor="middle" font-family="Figtree, sans-serif" font-size="14" font-weight="650" fill="var(--fg)">Home Assistant on the Mac Studio</text>
  <text x="180" y="554" text-anchor="middle" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">
    <tspan x="180" dy="0">Watches the WiiM. Switches the</tspan>
    <tspan x="180" dy="16">StealthTech to Optical when it plays,</tspan>
    <tspan x="180" dy="16">and back to HDMI-ARC 30 s after it stops.</tspan>
  </text>
  <line x1="180" y1="626" x2="180" y2="674" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#lovesac-arrow)"></line>
  <text x="188" y="662" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">Wi-Fi</text>
  <rect x="48" y="678" width="264" height="68" rx="8" fill="var(--card)" stroke="var(--line)"></rect>
  <text x="180" y="704" text-anchor="middle" font-family="Figtree, sans-serif" font-size="15" font-weight="650" fill="var(--fg)">ATOM Lite</text>
  <text x="180" y="724" text-anchor="middle" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">ESPHome Bluetooth proxy by the couch</text>
  <path d="M312 712 H344 V330 H332" fill="none" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#lovesac-arrow)"></path>
  <text x="292" y="390" font-family="Figtree, sans-serif" font-size="12" fill="var(--muted)">Bluetooth</text>
</svg>
<figcaption>Sound, AirPlay, and the shared remote.</figcaption>
</figure>`;

const figure = `<figure class="phone"><img src="/assets/images/couch-dashboard.webp" width="${DASH_W}" height="${DASH_H}" alt="The Couch dashboard on a phone, with Power, Mute and volume buttons, input buttons for TV, Music, Bluetooth and AUX, sound modes, and a Quiet Couch toggle" loading="lazy" decoding="async"><figcaption>My Couch dashboard on my phone.</figcaption></figure>`;

function render(markdown) {
  const lines = markdown.replace(/\r\n/g, '\n').split('\n');
  const html = [];
  let i = 0;
  let lastHeading = '';
  while (i < lines.length) {
    const line = lines[i];
    if (line.trim() === '' || line.trim() === '#grok bot/home#') { i += 1; continue; }
    if (line.startsWith('# ') && !line.startsWith('## ')) { i += 1; continue; }
    if (line.startsWith('## ')) {
      const text = line.slice(3).trim();
      lastHeading = text;
      const id = text === "The words you'll see" ? ' id="words"' : '';
      html.push(`<h2${id}>${inline(text)}</h2>`);
      i += 1;
      continue;
    }
    if (line.startsWith('```')) {
      const buf = [];
      i += 1;
      while (i < lines.length && !lines[i].startsWith('```')) { buf.push(lines[i]); i += 1; }
      i += 1;
      html.push(`<pre><code>${escapeHtml(buf.join('\n'))}</code></pre>`);
      continue;
    }
    if (line.startsWith('|')) {
      const buf = [];
      while (i < lines.length && lines[i].startsWith('|')) { buf.push(lines[i]); i += 1; }
      html.push(tableHtml(buf));
      continue;
    }
    if (line.startsWith('- ')) {
      const items = [];
      while (i < lines.length && lines[i].startsWith('- ')) { items.push(lines[i].slice(2)); i += 1; }
      html.push(`<ul>${items.map((item) => `<li>${inline(item)}</li>`).join('')}</ul>`);
      if (lastHeading === "The words you'll see") html.push(diagram);
      continue;
    }
    const buf = [line];
    i += 1;
    while (i < lines.length && lines[i].trim() !== '' && !lines[i].startsWith('#') && !lines[i].startsWith('|') && !lines[i].startsWith('```') && !lines[i].startsWith('- ')) {
      buf.push(lines[i]);
      i += 1;
    }
    const text = buf.join(' ');
    html.push(`<p>${inline(text)}</p>`);
    if (text.startsWith('**Disclaimer**')) html.push(buyBox);
    if (text.startsWith('I built a Couch dashboard for it')) html.push(figure);
  }
  return html.join('\n');
}

const body = render(article);
---
<Base title="Making Lovesac StealthTech smart" path="/making-lovesac-stealthtech-smart/" description="How I added AirPlay, Siri and a shared phone remote to a Lovesac StealthTech with a WiiM streamer, a small Bluetooth chip and Home Assistant." robots="noindex, nofollow">
  <article class="piece">
    <h1>Making Lovesac Stealthtech Smart</h1>
    <div set:html={body} />
  </article>
</Base>
<style>
  .piece { max-width: min(42rem, 100%); overflow-x: clip; }
  .piece :global(p) { margin: 0 0 1rem; }
  .piece :global(h2) { margin: 2.25rem 0 .75rem; }
  .piece :global(ul) { margin: 0 0 1rem; padding-left: 1.2rem; }
  .piece :global(li) { margin: .4rem 0; }
  .piece :global(code) { font-family: var(--mono); font-size: .92em; overflow-wrap: anywhere; }
  .piece :global(pre code) { overflow-wrap: normal; white-space: pre; }
  .piece :global(pre) {
    font-family: var(--mono);
    font-size: .82rem;
    line-height: 1.45;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    max-width: 100%;
    margin: 0 0 1rem;
  }
  .piece :global(pre code) { font-size: inherit; }
  .piece :global(.table-scroll) { overflow-x: auto; max-width: 100%; margin: 0 0 1rem; }
  .piece :global(table) { width: 100%; border-collapse: collapse; }
  .piece :global(th),
  .piece :global(td) {
    text-align: left;
    vertical-align: top;
    padding: .65rem .75rem .65rem 0;
    border-bottom: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  .piece :global(th) { color: var(--muted); font-weight: 600; }
  .piece :global(.kit) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem 1.15rem;
    margin: 0 0 1.25rem;
  }
  .piece :global(.kit-title) { font-weight: 650; margin: 0 0 .4rem; }
  .piece :global(.kit ul) { margin: 0; }
  .piece :global(.phone) { margin: 1.25rem auto 1.5rem; max-width: 17.5rem; }
  .piece :global(.phone img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .piece :global(.phone figcaption) { color: var(--muted); font-size: .9rem; margin-top: .45rem; text-align: center; }
  .piece :global(.diagram) { margin: 1.5rem 0 1.75rem; max-width: 100%; }
  .piece :global(.diagram svg) { width: min(100%, 22.5rem); height: auto; display: block; }
  .piece :global(.diagram text) { font-family: Figtree, sans-serif; }
  .piece :global(.diagram figcaption) { color: var(--muted); font-size: .9rem; margin-top: .45rem; }
</style>
