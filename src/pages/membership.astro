---
import Base from '../layouts/Base.astro';
import membership from '../data/membership.json';
import { visible } from '../lib/copy.js';
import { isLiveUrl } from '../lib/links.js';
const price = visible(membership.price);
const perks = (membership.perks || []).map(visible).filter(Boolean);
const checkout = isLiveUrl(membership.checkoutUrl) ? membership.checkoutUrl : '';
---
<Base title="Membership" path="/membership/" robots="noindex" description="Membership for Kyle Beck's site. Not open yet.">
  <p class="eyebrow">Membership</p>
  <h1>Membership</h1>
  <p class="lede">Not open yet.</p>
  {price && <p class="price">{price}</p>}
  {perks.length > 0 && <ul class="list" style="margin-top:2rem">{perks.map((perk) => <li><p>{perk}</p></li>)}</ul>}
  {checkout && <div class="row"><a class="btn solid" href={checkout}>Join</a></div>}
</Base>
