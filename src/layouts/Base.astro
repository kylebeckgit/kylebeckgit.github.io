---
import '../styles/fonts.css';
import '../styles/global.css';
import copy from '../data/copy.json';
import { aboutInNav } from '../lib/copy.js';
// Font pairing switch: PUBLIC_FONT=specsheet|linernotes|frontpanel at build/dev time
const font = import.meta.env.PUBLIC_FONT || 'specsheet';
const { title, description = 'Kyle Beck: musician and sound designer. Tonverk sample packs, synth guides and browser-based sound design tools.', path = '/', robots } = Astro.props;
const full = title ? `${title} | Kyle Beck` : 'Kyle Beck, Musician & Sound Designer';
const nav = [['/packs/','Packs'],['/library/','Library'],['/tools/','Tools'],...(aboutInNav(copy) ? [['/about/','About']] : []),['/contact/','Contact']];
const canonical = new URL(path, 'https://kyle-beck.com').href;
const ogImage = 'https://kyle-beck.com/assets/images/og.png';
---
<!doctype html>
<html lang="en" data-font={font}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{full}</title><meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={full}><meta property="og:description" content={description}>
<meta property="og:url" content={canonical}><meta property="og:type" content="website">
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Kyle Beck">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
{robots && <meta name="robots" content={robots}>}
<link rel="preload" as="font" type="font/woff2" crossorigin href={{specsheet:"/fonts/figtree/figtree-latin-wght-normal.woff2",linernotes:"/fonts/young-serif/young-serif-latin-400-normal.woff2",frontpanel:"/fonts/big-shoulders-display/big-shoulders-display-latin-wght-normal.woff2"}[font]}>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/images/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#f2ede3" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)">
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Person","name":"Kyle Beck","jobTitle":"Musician & Sound Designer","url":"https://kyle-beck.com","sameAs":["https://github.com/kylebeckgit"]})}></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site"><div class="wrap">
  <a class="brand" href="/">
    <img class="mark mark-for-light" src="/assets/images/favicon.svg" alt="" width="34" height="34">
    <img class="mark mark-for-dark" src="/assets/images/mark-on-dark.svg" alt="" width="34" height="34">
    <span class="visually-hidden">Kyle Beck</span>
  </a>
  <nav aria-label="Main"><ul>{nav.map(([h,l]) => <li><a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a></li>)}</ul></nav>
</div></header>
<main id="main"><div class="wrap"><slot /></div></main>
<footer class="site"><div class="wrap">
  <span>© {new Date().getFullYear()} Kyle Beck</span>
  <ul><li><a href="mailto:kyle@kyle-beck.com">Email</a></li><li><a href="https://github.com/kylebeckgit">GitHub</a></li><li><a href="https://buymeacoffee.com/kylebeck">Buy Me a Coffee</a></li></ul>
</div></footer>
</body></html>
