{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modal-describe",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "MEMBERSHIP_ENABLED": "false",
    "MEMBERSHIP_PRODUCT_ID": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Limiter"] }
  ]
}
